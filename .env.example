# ==============================================================================
# Antidote Issue Tracker - Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ALLGEMEINE GRUNDEINSTELLUNGEN
# ------------------------------------------------------------------------------
# In Produktion IMMER auf False setzen!
DEBUG=True

# Generiere einen sicheren Schlüssel z. B. mit:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key-change-in-production-1234567890

# ------------------------------------------------------------------------------
# 2. NETZWERK & SICHERHEIT (ALLOWED_HOSTS & CSRF_TRUSTED_ORIGINS)
# ------------------------------------------------------------------------------
# Kommagetrennte Liste der erlaubten Hostnamen / Domains
ALLOWED_HOSTS=127.0.0.1,localhost,.trycloudflare.com

# Vertrauenswürdige Ursprünge für CSRF (mit http:// oder https://!)
# Unbedingt nötig für Login und Formulare über HTTPS-Tunnels oder Domains!
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.trycloudflare.com

# ------------------------------------------------------------------------------
# 3. DATENBANK (DATABASE_URL)
# ------------------------------------------------------------------------------
# Standard: SQLite lokal
DATABASE_URL=sqlite:///db.sqlite3

# Für VPS-Produktion (ausgelagert in /var/www/antidote/data):
# DATABASE_URL=sqlite:////var/www/antidote/data/db.sqlite3

# Für PostgreSQL:
# DATABASE_URL=postgres://antidote_user:secret_password@localhost:5432/antidote

# ------------------------------------------------------------------------------
# 4. STATISCHE DATEIEN & UPLOADS (OPTIONAL)
# ------------------------------------------------------------------------------
# Auf dem VPS durch Nginx ausgeliefert:
# STATIC_ROOT=/var/www/antidote/staticfiles
# MEDIA_ROOT=/var/www/antidote/media
# USE_X_ACCEL_REDIRECT=True

# Maximale Dateigröße für Uploads in Bytes (Standard: 10 MB = 10485760)
MAX_ATTACHMENT_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. FRONTEND ENTWICKLUNGSMODUS (VITE HMR)
# ------------------------------------------------------------------------------
# Wenn True: Verwendet den lokalen Vite-Dev-Server (http://localhost:5173).
# Wenn False: Lädt die gebündelten Produktiv-Dateien aus static/dist/.
# Für Cloudflare Tunnel & VPS IMMER False (oder weglassen)!
VITE_DEV_MODE=False


