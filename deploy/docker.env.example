# Für Docker: Diese Datei im Projektverzeichnis nach .env kopieren.
# Für Cloudflare Tunnel beide Compose-Dateien verwenden.
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml
DOMAIN=antidote.example.com
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS
MAX_ATTACHMENT_SIZE_BYTES=15728640
# Token eines verwalteten Cloudflare Tunnels; leer lassen bis zur Einrichtung.
TUNNEL_TOKEN=
